{
  "version": 2,
  "normalisation": false,
  "gapless": true,
  "lyrics_for_local_files": true,
  "karaoke_lyrics": true,
  "blur_lyrics": true,
  "romanized_lyrics": true,
  "panel_lyrics_scale": 1.0,
  "fullscreen_lyrics_scale": 1.0,
  "romanization_scripts": {
    "japanese": true,
    "chinese": true,
    "korean": true,
    "cyrillic": false,
    "greek": false,
    "arabic": false,
    "other": false
  },
  "adaptive_menu": false,
  "check_updates": false,
  "close_to_tray": true,
  "language": "auto",
  "font": "auto",
  "startup": "home",
  "appearance": {
    "theme": "dark",
    "adaptive_theme": false,
    "visualizer": true,
    "icons": "lucide",
    "rounding": "round",
    "font_size": 14.0,
    "transparent": false,
    "transparency": 0.15,
    "server_side_decorations": true,
    "window_controls": true,
    "controls_on_left": false,
    "reduce_motion": "system",
    "motion_pace": "base",
    "battery_saver": "off",
    "theme_overrides": {
        "background": "{{colors.background.default.hex}}",
        "foreground": "{{colors.on_background.default.hex}}",
        "border": "{{colors.outline.default.hex | lighten: -20.0}}",
        "muted": "{{colors.primary_surface.default.hex}}",
        "muted_foreground": "{{colors.on_primary_surface.default.hex}}",
        "overlay": "{{colors.surface.default.hex}}",
        "overlay_foreground": "{{colors.on_surface.default.hex}}",
        "secondary": "{{colors.secondary_container.default.hex}}",
        "secondary_hover": "{{colors.on_secondary_container.default.hex | lighten: 10.0}}",
        "secondary_active": "{{colors.secondary_container.default.hex | lighten: 20.0}}",
        "primary": "{{colors.primary.default.hex}}",
        "primary_foreground": "{{colors.on_primary_container.default.hex | lighten: 10.0}}",
        "primary_hover": "{{colors.primary_container.default.hex | lighten: 20.0}}",
        "danger": "{{colors.error.default.hex}}",
        "danger_foreground": "{{colors.on_error.default.hex}}",
        "danger_hover": "{{colors.error.default.hex | lighten: 10.0}}",
        "popover": "{{colors.surface.default.hex}}",
        "popover_foreground": "{{colors.on_surface.default.hex}}",
        "progress_bar": "{{colors.primary.default.hex}}",
        "selection": "{{colors.surface.default.hex}}",
        "sidebar": "{{colors.surface.default.hex}}",
        "sidebar_accent": "{{colors.primary_container.default.hex}}",
        "sidebar_border": "{{colors.outline.default.hex | lighten: -20.0}}",
        "title_bar_border": "{{colors.outline.default.hex | lighten: -20.0}}",
        "table_head": "{{colors.primary_container.default.hex}}",
        "table_head_foreground": "{{colors.on_primary_container.default.hex}}",
        "table_row_border": "{{colors.outline.default.hex | lighten: -20.0}}",
        "table_hover": "{{colors.primary_container.default.hex}}",
        "table_active": "{{colors.primary_container.default.hex}}",
        "table_active_border": "{{colors.outline.default.hex | lighten: -20.0}}",
        "radius": null,
        "font_size": null
    }
  }
}
