        "popover_foreground": "{fg}",
        "progress_bar": "{accent}",
        "selection": "{accent}",
        "sidebar": "{surface}",
        "sidebar_accent": "{accent}",
        "sidebar_border": "{dim}",
        "title_bar_border": "{dim}",
        "table_head": "{surface}",
        "table_head_foreground": "{fg}",
        "table_row_border": "{dim}",
        "table_hover": "{surface}",
        "table_active": "{surface}",
        "table_active_border": "{dim}",
